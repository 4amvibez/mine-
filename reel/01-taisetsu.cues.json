{
  "handle": "",
  "cues": [
    [0.00,  "もし明日、",                     "If, starting tomorrow,"],
    [1.06,  "大切な人に",                     "you could never see"],
    [2.24,  "二度と会えなくなるとしたら、",     "someone dear to you again,"],
    [4.38,  "あなたは今日、",                 "what would you"],
    [5.26,  "何を伝えますか。",               "tell them today?"],
    [7.58,  "人はなぜ、",                     "Why is it"],
    [8.72,  "大切なものを失ってから、",         "that only after we lose what matters"],
    [10.92, "その本当の価値に",               "do we finally see"],
    [12.48, "気づくのだろう。",               "its true worth?"],
    [13.68, "いつも隣にいてくれる人も、",       "The people always by our side,"],
    [16.22, "何気なく過ごしている日々も、",     "the days we take for granted—"],
    [18.62, "永遠に続くものだと",             "somewhere deep down,"],
    [20.66, "どこかで思い込んでしまう。",       "we believe they’ll last forever."],
    [22.90, "けれど、",                       "But"],
    [23.72, "人生には",                       "in life, there are"],
    [24.76, "二度と取り戻せない瞬間がある。",   "moments we can never get back."],
    [27.90, "何気ない会話も、",               "The small, everyday conversations,"],
    [29.62, "くだらないことで",               "the times we laughed"],
    [30.68, "笑い合った時間も、",             "over silly little things—"],
    [32.54, "失って初めて",                   "only after losing them"],
    [34.24, "その一つ一つが",                 "do we realize that each one"],
    [35.78, "どれほど尊いものだったのかに",     "was more precious"],
    [38.02, "気づく。",                       "than we ever knew."],
    [38.76, "時間は",                         "Time is"],
    [39.50, "残酷なほど無情だ。",             "heartless, almost cruel."],
    [41.82, "どれほど後悔しても、",           "No matter how deeply we regret it,"],
    [43.90, "過ぎ去った日々を",               "the days that have passed"],
    [45.20, "取り戻すことはできない。",         "can never be brought back."],
    [47.24, "だからこそ、",                   "That’s why,"],
    [48.20, "伝えたい言葉があるなら、",         "if there are words you want to say,"],
    [50.26, "今日伝えてほしい。",             "please say them today."],
    [52.54, "あなたには、",                   "Is there someone"],
    [53.52, "今すぐ「ありがとう」と",           "you want to say “thank you” to"],
    [55.58, "伝えたい人がいますか。",           "right now?"],
    [57.66, "忘れたくない人がいるなら、",       "If there’s someone you never want to forget,"],
    [59.80, "この動画を",                     "please send this video"],
    [60.90, "その人に届けてください。",         "to them."]
  ]
}
